# Optional provider configuration. Never commit real values.
MAGIBU_TOOLCALL_DEEPSEEK_API_KEY=
MAGIBU_TOOLCALL_DEEPSEEK_MODEL=deepseek-v4-pro
MAGIBU_TOOLCALL_DEEPSEEK_BASE_URL=https://api.deepseek.com
MAGIBU_TOOLCALL_DEEPSEEK_MAX_OUTPUT_TOKENS=8192
MAGIBU_TOOLCALL_OPENAI_API_KEY=
MAGIBU_TOOLCALL_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
MAGIBU_TOOLCALL_OPENAI_ESCALATION_MODEL=gpt-5.4-2026-03-05
MAGIBU_TOOLCALL_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAGIBU_TOOLCALL_OPENAI_BASE_URL=https://api.openai.com/v1
MAGIBU_TOOLCALL_OPENAI_REASONING_EFFORT=low
MAGIBU_TOOLCALL_OPENAI_MAX_OUTPUT_TOKENS=1200
MAGIBU_TOOLCALL_OPENAI_DAILY_TOKEN_BUDGET=2100000
MAGIBU_TOOLCALL_OPENAI_ESCALATION_DAILY_TOKEN_BUDGET=200000

# Local behavior
MAGIBU_TOOLCALL_LOG_LEVEL=INFO
MAGIBU_TOOLCALL_ROOT=
MAGIBU_TOOLCALL_MAX_RETRIES=2
MAGIBU_TOOLCALL_RETRY_BASE_SECONDS=1.0
MAGIBU_TOOLCALL_REQUEST_TIMEOUT_SECONDS=60
MAGIBU_TOOLCALL_PROVIDER_MAX_WORKERS=1
MAGIBU_TOOLCALL_SEMANTIC_CACHE_DIR=
