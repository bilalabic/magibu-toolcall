{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magibu-toolcall.local/schemas/access_policy.schema.json",
  "title": "magibu-toolcall reviewer and operator access policy 0.1.0",
  "type": "object",
  "required": ["policy_version", "benchmark_dataset_team_exclusive", "principals"],
  "properties": {
    "policy_version": {"const": "0.1.0"},
    "benchmark_dataset_team_exclusive": {"type": "boolean"},
    "principals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "active", "teams", "roles", "permissions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
          "active": {"type": "boolean"},
          "teams": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["dataset", "benchmark", "platform"]}},
          "roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["contributor", "language_reviewer", "technical_reviewer", "dataset_lead", "benchmark_lead", "operator"]}
          },
          "permissions": {
            "type": "array", "uniqueItems": true,
            "items": {"enum": ["source_import", "localize", "generate", "quality_check", "review", "accept", "export", "freeze", "benchmark_run", "real_api"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
