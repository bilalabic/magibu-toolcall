{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magibu-toolcall.local/schemas/snapshot_provenance.schema.json",
  "title": "magibu-toolcall versioned source snapshot provenance 0.1.0",
  "type": "object",
  "required": [
    "snapshot_provenance_version", "provider", "source_name", "snapshot_version",
    "retrieved_at", "license", "license_url", "data_file", "sources", "transformation_notes"
  ],
  "properties": {
    "snapshot_provenance_version": {"const": "0.1.0"},
    "provider": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "snapshot_version": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$"},
    "retrieved_at": {"type": "string", "format": "date"},
    "license": {"type": "string", "minLength": 1},
    "license_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "data_file": {"$ref": "#/$defs/snapshot_relative_path"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["raw_file", "sha256", "release_id", "source_url", "release_date"],
        "properties": {
          "raw_file": {"$ref": "#/$defs/snapshot_relative_path"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "release_id": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "release_date": {"type": "string", "format": "date"},
          "label": {"type": "string", "minLength": 1},
          "source_name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "transformation_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "$defs": {
    "snapshot_relative_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
