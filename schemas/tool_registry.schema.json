{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magibu-toolcall.local/schemas/tool_registry.schema.json",
  "title": "magibu-toolcall canonical registry record 0.1.0",
  "type": "object",
  "required": ["tool_registry_version", "tool_id", "tool_version", "domain", "function", "output_schema", "execution", "access", "risks", "lifecycle"],
  "properties": {
    "tool_registry_version": {"const": "0.1.0"},
    "tool_id": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/tool_id"},
    "tool_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "function": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/tool_definition/properties/function"},
    "output_schema": {"type": "object", "minProperties": 1},
    "execution": {
      "type": "object",
      "required": ["default_type", "supported_types", "fixture_ids", "resettable"],
      "properties": {
        "default_type": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/execution_type"},
        "supported_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/execution_type"},
          "not": {"contains": {"const": "not_applicable"}}
        },
        "fixture_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "uniqueItems": true},
        "resettable": {"type": "boolean"},
        "http": {
          "type": "object",
          "required": ["method", "url", "allowed_hosts", "query_map", "headers", "authentication", "response_path", "timeout_ms"],
          "properties": {
            "method": {"const": "GET"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}},
            "query_map": {
              "type": "object",
              "propertyNames": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/parameter_name"},
              "additionalProperties": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/parameter_name"}
            },
            "headers": {"type": "object", "additionalProperties": {"type": "string"}},
            "authentication": {
              "type": "object",
              "required": ["type", "env_var", "header", "prefix"],
              "properties": {
                "type": {"enum": ["none", "bearer", "header"]},
                "env_var": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
                "header": {"type": ["string", "null"], "minLength": 1},
                "prefix": {"type": "string"}
              },
              "additionalProperties": false
            },
            "response_path": {"type": "array", "items": {"type": ["string", "integer"]}},
            "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["source", "url", "authentication", "credential_env_vars", "license", "license_url", "terms_checked_on"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "format": "uri"},
        "authentication": {"enum": ["none", "api_key", "oauth", "sandbox_only", "not_applicable"]},
        "credential_env_vars": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true},
        "license": {"type": ["string", "null"]},
        "license_url": {"type": ["string", "null"], "format": "uri"},
        "terms_checked_on": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    },
    "risks": {
      "type": "object",
      "required": ["safety", "freshness", "personal_data", "side_effects", "notes"],
      "properties": {
        "safety": {"enum": ["low", "medium", "high", "unknown"]},
        "freshness": {"enum": ["static", "time_sensitive", "volatile", "unknown"]},
        "personal_data": {"type": "boolean"},
        "side_effects": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "lifecycle": {"enum": ["demo", "candidate", "approved", "deprecated"]}
  },
  "additionalProperties": false
}
