{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magibu-toolcall.local/schemas/job_manifest.schema.json",
  "title": "magibu-toolcall resumable job manifest 0.1.0",
  "type": "object",
  "required": [
    "job_version", "job_id", "lifecycle", "operation", "input_path", "input_sha256",
    "output_path", "error_path", "checkpoint_path", "total_items", "shard_size",
    "shards", "target_distributions", "id_plan", "registry_binding", "status", "counts", "created_at", "updated_at"
  ],
  "properties": {
    "job_version": {"const": "0.1.0"},
    "job_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "lifecycle": {"enum": ["dataset", "benchmark"]},
    "operation": {"enum": ["source_import", "source_localization", "scenario_generation", "benchmark_generation"]},
    "input_path": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_path": {"type": "string", "minLength": 1},
    "error_path": {"type": "string", "minLength": 1},
    "checkpoint_path": {"type": "string", "minLength": 1},
    "total_items": {"type": "integer", "minimum": 1},
    "shard_size": {"type": "integer", "minimum": 1},
    "shards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "start", "end", "status"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "status": {"enum": ["pending", "running", "completed", "completed_with_errors"]}
        },
        "additionalProperties": false
      }
    },
    "target_distributions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "integer", "minimum": 0}
      }
    },
    "id_plan": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["source_type", "start_number", "end_number"],
          "properties": {
            "source_type": {"$ref": "https://magibu-toolcall.local/schemas/common.schema.json#/$defs/source_type"},
            "start_number": {"type": "integer", "minimum": 1},
            "end_number": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "registry_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "status": {"enum": ["planned", "running", "completed", "completed_with_errors", "failed"]},
    "counts": {
      "type": "object",
      "required": ["processed", "succeeded", "failed"],
      "properties": {
        "processed": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
